[auth]
# For Community Cloud, replace this with https://<app-host>/oauth2callback.
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-at-least-32-random-characters"
client_id = "replace-with-google-client-id"
client_secret = "replace-with-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[app]
allowed_domain = "iiti.ac.in"
admin_emails = ["your-address@iiti.ac.in"]
user_key_secret = "replace-with-a-separate-strong-random-value"

[supabase]
url = "https://your-project-ref.supabase.co"
service_role_key = "replace-with-supabase-service-role-key"

[gemini]
api_key = "replace-with-google-ai-api-key"

[ai_star]
api_key = "replace-with-ai-star-api-key"
